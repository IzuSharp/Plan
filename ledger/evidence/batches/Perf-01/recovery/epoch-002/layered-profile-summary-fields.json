  "groups": {
    "inspect": {
      "file": "cell/inspect-{process_index}.json",
      "processes": 3,
      "copy": [
        "status", "error", "completed_measured_calls", "completed_warmup_calls", "completed_batches",
        "stopwatch_frequency", "first_inspect", "warmup", "samples", "server_gc", "gc_latency_mode",
