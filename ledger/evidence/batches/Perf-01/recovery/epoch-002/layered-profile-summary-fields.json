      ],
      "arithmetic_per_process": {
        "measured_calls": "sum(samples[].calls); require equality to completed_measured_calls",
        "measured_wall_seconds": "sum(samples[].wall_stopwatch_ticks) / stopwatch_frequency",
        "measured_wall_ns_per_call": "sum(samples[].wall_stopwatch_ticks) * 1e9 / stopwatch_frequency / completed_measured_calls",
        "calling_thread_allocated_bytes": "sum(samples[].calling_thread_allocated_bytes)",
        "calling_thread_allocated_bytes_per_call": "sum(samples[].calling_thread_allocated_bytes) / completed_measured_calls",
        "process_cpu_seconds": "sum(samples[].process_cpu_time_span_ticks) / 1e7",
        "gen0_collections": "sum(samples[].gen0_collections)",
        "gen1_collections": "sum(samples[].gen1_collections)",
        "gen2_collections": "sum(samples[].gen2_collections)"
      },
      "scope": "Measured batches only; first load and warmup separate. Calling-thread allocation, wider process CPU bracket. No process pooling or percentile synthesis.",
      "unavailable": ["RSS", "native allocated bytes", "post-idle resource series"]
    },
    "page": {
      "file": "cell/result.json",
      "copy": [
        "Status", "FailureType", "Provider", "RequestedPages", "CompletedPages", "RowsPerPage",
        "CompletedWarmupPages", "MeasurementStartUtc", "MeasurementEndUtc", "ElapsedTicks",
        "StopwatchFrequency", "FullPageTicks", "ProcessManagedAllocatedBytes", "ManagedBytesPerCompletedPage",
        "ProcessCpuMilliseconds", "GcCollections", "SeedCommitted", "SeedTransactionReleased",
        "SeedSessionReleased", "PageSessionReleased", "CleanupSessionReleased", "SourceReleased",
        "TableDropped", "DynamicCodeSupported", "CpuAffinity", "ExecutableSha256", "BuildManifestSha256",
        "LoadedNativeModules", "FixtureSha256"
      ],
      "arithmetic": {
        "completed_rows": "CompletedPages * RowsPerPage",
        "wall_seconds": "ElapsedTicks / StopwatchFrequency",
        "wall_ns_per_page": "ElapsedTicks * 1e9 / StopwatchFrequency / CompletedPages",
        "process_cpu_seconds": "ProcessCpuMilliseconds / 1000"
      },
      "scope": "Full serial typed public query, DTO/list materialization, cleanup and exact validation. Allocation/CPU include runtime work. No new per-page percentile calculation.",
      "unavailable": ["RSS", "pool wait", "pure database duration", "native allocated bytes"]
    },
    "retirement": {
      "file": "cell/result.json",
      "copy": [
        "Provider", "Calls", "StopwatchFrequency", "PublicCallMilliseconds", "NativeOperations",
        "ManagedAllocatedBytesIncludingObserver", "ProcessCpuMilliseconds", "GcCollections",
        "SourceReleased", "LoadedNativeModules", "Scope"
      ],
      "native_operation_fields": ["Start", "StartReturned", "Terminal", "BeforeTake", "Retired"],
      "arithmetic": {
        "public_call_time_sum_ms": "sum(PublicCallMilliseconds[])",
        "instrumented_mean_public_call_ms": "sum(PublicCallMilliseconds[]) / Calls",
        "managed_allocated_bytes_per_call_including_observer": "ManagedAllocatedBytesIncludingObserver / Calls",
        "observed_native_operation_count": "length(NativeOperations)",
        "process_cpu_seconds": "ProcessCpuMilliseconds / 1000"
      },
      "scope": "Public-call time sum is not an outer elapsed window. Observer instrumentation remains included. Native operations are not a count of every FFI crossing. Do not subtract absent/zero/unordered endpoints.",
