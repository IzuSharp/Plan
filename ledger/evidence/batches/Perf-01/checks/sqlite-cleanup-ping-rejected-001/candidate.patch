+async fn post_cleanup_transaction_state(file: &Path) -> TestResult {
+    let file = file.with_file_name("perf01-cleanup-state.db");
+    assert!(
+        !file.exists(),
+        "the cleanup-state case needs a fresh database"
+    );
+    let pool = pool(&file, &Options::default(), limits()).await?;
+    let (s, budget) = session(&pool, Options::default(), limits()).await?;
+    // This deliberately changes SQLite's autocommit state outside SQLx's
+    // transaction manager. Successful worker cleanup must not mark it usable.
+    let mut rows = s.stream("BEGIN DEFERRED", None, Cancellation::default())?;
+    let receipt = rows.receipt();
+    assert!(tokio::time::timeout(WAIT, rows.next()).await?.is_none());
+    let retired = tokio::time::timeout(WAIT, receipt.join()).await??;
+    assert!(retired.native_retired && retired.progress_handler_removed);
+    assert_eq!(retired.disposition, ConnectionDisposition::Quarantined);
+    assert_eq!(budget.snapshot().active_commands, 0);
+    assert_eq!(budget.snapshot().queued_commands, 0);
+    assert_eq!(budget.snapshot().retained_input_bytes, 0);
+    assert_eq!(rows.buffered_rows(), 0);
+    assert!(matches!(
+        s.stream("SELECT 1", None, Cancellation::default())
+            .err()
+            .map(|e| e.kind),
+        Some(ErrorKind::Closed)
+    ));
+    drop(rows);
+    close(s, pool).await?;
+    assert_eq!(budget.snapshot().active_commands, 0);
+    assert_eq!(budget.snapshot().queued_commands, 0);
+    assert_eq!(budget.snapshot().retained_input_bytes, 0);
+    println!("PASS Perf-01 SQLite cleanup-state mismatch quarantined and retired");
+    Ok(())
+}
