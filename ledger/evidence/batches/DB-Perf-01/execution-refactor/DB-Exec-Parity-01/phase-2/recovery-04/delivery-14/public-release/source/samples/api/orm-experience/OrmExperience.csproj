<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <AssemblyName>OrmExperience</AssemblyName>
    <Provider Condition="'$(Provider)' == ''">Sqlite</Provider>
    <KordaVersion Condition="'$(KordaVersion)' == ''">0.1.0-db-api.1</KordaVersion>
    <DefineConstants Condition="'$(Provider)' == 'PostgreSql'">$(DefineConstants);POSTGRES</DefineConstants>
    <DefineConstants Condition="'$(DtoEdit)' == 'true'">$(DefineConstants);DTO_EDIT</DefineConstants>
    <DefineConstants Condition="'$(CompileScaffold)' == 'true'">$(DefineConstants);SCAFFOLD_COMPILED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Korda.Database.$(Provider)" Version="$(KordaVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>
</Project>
