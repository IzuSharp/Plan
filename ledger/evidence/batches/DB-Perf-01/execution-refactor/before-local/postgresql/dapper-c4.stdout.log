ame\u0022 AS \u0022Name\u0022 FROM \u0022orders\u0022 LEFT JOIN (SELECT \u0022Email\u0022, \u0022Name\u0022, \u0022Id\u0022, 1 AS \u0022_nw_match\u0022 FROM \u0022customers\u0022) AS \u0022customer\u0022 ON \u0022orders\u0022.\u0022CustomerId\u0022 = \u0022customer\u0022.\u0022Id\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p2","inner-join":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022, \u0022customer\u0022.\u0022Name\u0022 AS \u0022Name\u0022 FROM \u0022orders\u0022 INNER JOIN \u0022customers\u0022 AS \u0022customer\u0022 ON \u0022orders\u0022.\u0022CustomerId\u0022 = \u0022customer\u0022.\u0022Id\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p2","null-notes":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 AND \u0022orders\u0022.\u0022Note\u0022 IS NULL ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p2","literal-note":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 AND \u0022orders\u0022.\u0022Note\u0022 LIKE @pattern ESCAPE E\u0027\\\\\u0027 ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p3","customer-totals":"SELECT \u0022orders\u0022.\u0022CustomerId\u0022 AS \u0022CustomerId\u0022, COUNT(*) AS \u0022Count\u0022, SUM(\u0022orders\u0022.\u0022Total\u0022) AS \u0022Total\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 GROUP BY \u0022orders\u0022.\u0022CustomerId\u0022 HAVING COUNT(*) \u003E @p2 ORDER BY \u0022orders\u0022.\u0022CustomerId\u0022 ASC NULLS LAST","product-totals":"SELECT \u0022order_lines\u0022.\u0022Product\u0022 AS \u0022Product\u0022, CAST(SUM(\u0022order_lines\u0022.\u0022Quantity\u0022) AS bigint) AS \u0022Quantity\u0022 FROM \u0022order_lines\u0022 WHERE \u0022order_lines\u0022.\u0022TenantId\u0022 = @p1 GROUP BY \u0022order_lines\u0022.\u0022Product\u0022 HAVING CAST(SUM(\u0022order_lines\u0022.\u0022Quantity\u0022) AS bigint) \u003E @p2 ORDER BY \u0022order_lines\u0022.\u0022Product\u0022 ASC NULLS LAST","empty-sum":"SELECT SUM(\u0022orders\u0022.\u0022Total\u0022) AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1","cursor":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 AND (\u0022orders\u0022.\u0022CreatedAt\u0022 \u003E @p2 OR (\u0022orders\u0022.\u0022CreatedAt\u0022 = @p3 AND (\u0022orders\u0022.\u0022TenantId\u0022 \u003E @p4 OR (\u0022orders\u0022.\u0022TenantId\u0022 = @p5 AND \u0022orders\u0022.\u0022Id\u0022 \u003E @p6)))) ORDER BY \u0022orders\u0022.\u0022CreatedAt\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022TenantId\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p7","offset":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 ORDER BY \u0022orders\u0022.\u0022CreatedAt\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022TenantId\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p2 OFFSET @p3","exists":"SELECT \u0022customers\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022customers\u0022 WHERE EXISTS(SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 AND \u0022orders\u0022.\u0022Id\u0022 \u003E= @p2) ORDER BY \u0022customers\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p3","in-subquery":"SELECT \u0022customers\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022customers\u0022 WHERE \u0022customers\u0022.\u0022Id\u0022 IN (SELECT \u0022orders\u0022.\u0022CustomerId\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 AND \u0022orders\u0022.\u0022Id\u0022 \u003E @p2) ORDER BY \u0022customers\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p3","cte":"WITH \u0022selected_order_ids\u0022 (\u0022Id\u0022) AS (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 AND \u0022orders\u0022.\u0022Id\u0022 \u003E @p2) SELECT \u0022selected_order_ids\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022selected_order_ids\u0022 ORDER BY \u0022selected_order_ids\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p3","window":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022, (ROW_NUMBER() OVER ( PARTITION BY \u0022orders\u0022.\u0022CustomerId\u0022 ORDER BY \u0022orders\u0022.\u0022CreatedAt\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST )) AS \u0022Rank\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p2","union-all":"WITH \u0022selected_order_ids\u0022 (\u0022Id\u0022) AS (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 AND \u0022orders\u0022.\u0022Id\u0022 \u003C= @p2 UNION ALL (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p3 AND (\u0022orders\u0022.\u0022Id\u0022 \u003E= @p4 AND \u0022orders\u0022.\u0022Id\u0022 \u003C= @p5))) SELECT \u0022selected_order_ids\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022selected_order_ids\u0022 ORDER BY \u0022selected_order_ids\u0022.\u0022Id\u0022 ASC NULLS LAST","union":"WITH \u0022selected_order_ids\u0022 (\u0022Id\u0022) AS (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 AND \u0022orders\u0022.\u0022Id\u0022 \u003C= @p2 UNION (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p3 AND (\u0022orders\u0022.\u0022Id\u0022 \u003E= @p4 AND \u0022orders\u0022.\u0022Id\u0022 \u003C= @p5))) SELECT \u0022selected_order_ids\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022selected_order_ids\u0022 ORDER BY \u0022selected_order_ids\u0022.\u0022Id\u0022 ASC NULLS LAST","intersect":"WITH \u0022selected_order_ids\u0022 (\u0022Id\u0022) AS (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 AND \u0022orders\u0022.\u0022Id\u0022 \u003C= @p2 INTERSECT (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p3 AND (\u0022orders\u0022.\u0022Id\u0022 \u003E= @p4 AND \u0022orders\u0022.\u0022Id\u0022 \u003C= @p5))) SELECT \u0022selected_order_ids\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022selected_order_ids\u0022 ORDER BY \u0022selected_order_ids\u0022.\u0022Id\u0022 ASC NULLS LAST","except":"WITH \u0022selected_order_ids\u0022 (\u0022Id\u0022) AS (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 AND \u0022orders\u0022.\u0022Id\u0022 \u003C= @p2 EXCEPT (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p3 AND (\u0022orders\u0022.\u0022Id\u0022 \u003E= @p4 AND \u0022orders\u0022.\u0022Id\u0022 \u003C= @p5))) SELECT \u0022selected_order_ids\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022selected_order_ids\u0022 ORDER BY \u0022selected_order_ids\u0022.\u0022Id\u0022 ASC NULLS LAST","running-total":"SELECT \u0022order_lines\u0022.\u0022Id\u0022 AS \u0022Id\u0022, CAST(((SUM(\u0022order_lines\u0022.\u0022Quantity\u0022) OVER (  ORDER BY \u0022order_lines\u0022.\u0022Id\u0022 ASC NULLS LAST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW ))) AS bigint) AS \u0022Quantity\u0022 FROM \u0022order_lines\u0022 WHERE \u0022order_lines\u0022.\u0022TenantId\u0022 = @p1 ORDER BY \u0022order_lines\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p2","three-join":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022OrderId\u0022, \u0022customer\u0022.\u0022Name\u0022 AS \u0022Name\u0022, \u0022line\u0022.\u0022Product\u0022 AS \u0022Product\u0022, \u0022line\u0022.\u0022Quantity\u0022 AS \u0022Quantity\u0022 FROM \u0022orders\u0022 INNER JOIN \u0022customers\u0022 AS \u0022customer\u0022 ON \u0022orders\u0022.\u0022CustomerId\u0022 = \u0022customer\u0022.\u0022Id\u0022 INNER JOIN \u0022order_lines\u0022 AS \u0022line\u0022 ON \u0022orders\u0022.\u0022TenantId\u0022 = \u0022line\u0022.\u0022TenantId\u0022 AND \u0022orders\u0022.\u0022Id\u0022 = \u0022line\u0022.\u0022OrderId\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST, \u0022line\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p2","anti-association":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 AND (NOT \u0022orders\u0022.\u0022Id\u0022 IN (SELECT \u0022order_lines\u0022.\u0022OrderId\u0022 AS \u0022value\u0022 FROM \u0022order_lines\u0022 WHERE \u0022order_lines\u0022.\u0022TenantId\u0022 = @p2 AND \u0022order_lines\u0022.\u0022Quantity\u0022 \u003E= @p3)) ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p4","nullable-order":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = @p1 ORDER BY \u0022orders\u0022.\u0022CustomerId\u0022 ASC NULLS FIRST, \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT @p2","raw-sql":"SELECT \u0022Id\u0022,\u0022Note\u0022 FROM orders WHERE \u0022TenantId\u0022=@p1 ORDER BY \u0022Id\u0022 LIMIT @p2","related":"SELECT \u0022order_lines\u0022.\u0022Id