":4,"Completed":644,"Rows":15567,"Failed":0},{"Second":5,"Completed":8,"Rows":108,"Failed":0},{"Second":6,"Completed":0,"Rows":0,"Failed":0}],"TimeSeriesTruncated":false,"ActualDiagnosticSql":{"numeric":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","text":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022, \u0022orders\u0022.\u0022Note\u0022 AS \u0022Note\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","money":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022, \u0022orders\u0022.\u0022Total\u0022 AS \u0022Total\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","json":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022, \u0022orders\u0022.\u0022Settings\u0022 AS \u0022Settings\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","wide":"SELECT \u0022orders\u0022.\u0022TenantId\u0022 AS \u0022TenantId\u0022, \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022, \u0022orders\u0022.\u0022CreatedAt\u0022 AS \u0022CreatedAt\u0022, \u0022orders\u0022.\u0022CustomerId\u0022 AS \u0022CustomerId\u0022, \u0022orders\u0022.\u0022Total\u0022 AS \u0022Total\u0022, \u0022orders\u0022.\u0022Note\u0022 AS \u0022Note\u0022, \u0022orders\u0022.\u0022Version\u0022 AS \u0022Version\u0022, \u0022orders\u0022.\u0022Settings\u0022 AS \u0022Settings\u0022, \u0022orders\u0022.\u0022InternalMemo\u0022 AS \u0022InternalMemo\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","optional-filter":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND \u0022orders\u0022.\u0022CustomerId\u0022 = ? ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","range":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND (\u0022orders\u0022.\u0022CreatedAt\u0022 \u003E= ? AND \u0022orders\u0022.\u0022CreatedAt\u0022 \u003C ?) ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","left-join":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022, \u0022customer\u0022.\u0022Name\u0022 AS \u0022Name\u0022 FROM \u0022orders\u0022 LEFT JOIN (SELECT \u0022Email\u0022, \u0022Name\u0022, \u0022Id\u0022, 1 AS \u0022_nw_match\u0022 FROM \u0022customers\u0022) AS \u0022customer\u0022 ON \u0022orders\u0022.\u0022CustomerId\u0022 = \u0022customer\u0022.\u0022Id\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","inner-join":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022, \u0022customer\u0022.\u0022Name\u0022 AS \u0022Name\u0022 FROM \u0022orders\u0022 INNER JOIN \u0022customers\u0022 AS \u0022customer\u0022 ON \u0022orders\u0022.\u0022CustomerId\u0022 = \u0022customer\u0022.\u0022Id\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","null-notes":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND \u0022orders\u0022.\u0022Note\u0022 IS NULL ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","literal-note":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND \u0022orders\u0022.\u0022Note\u0022 LIKE ? ESCAPE \u0027\\\u0027 ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","customer-totals":"SELECT \u0022orders\u0022.\u0022CustomerId\u0022 AS \u0022CustomerId\u0022, COUNT(*) AS \u0022Count\u0022, SUM(\u0022orders\u0022.\u0022Total\u0022) AS \u0022Total\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? GROUP BY \u0022orders\u0022.\u0022CustomerId\u0022 HAVING COUNT(*) \u003E ? ORDER BY \u0022orders\u0022.\u0022CustomerId\u0022 ASC NULLS LAST","product-totals":"SELECT \u0022order_lines\u0022.\u0022Product\u0022 AS \u0022Product\u0022, SUM(\u0022order_lines\u0022.\u0022Quantity\u0022) AS \u0022Quantity\u0022 FROM \u0022order_lines\u0022 WHERE \u0022order_lines\u0022.\u0022TenantId\u0022 = ? GROUP BY \u0022order_lines\u0022.\u0022Product\u0022 HAVING SUM(\u0022order_lines\u0022.\u0022Quantity\u0022) \u003E ? ORDER BY \u0022order_lines\u0022.\u0022Product\u0022 ASC NULLS LAST","empty-sum":"SELECT SUM(\u0022orders\u0022.\u0022Total\u0022) AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ?","cursor":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND (\u0022orders\u0022.\u0022CreatedAt\u0022 \u003E ? OR (\u0022orders\u0022.\u0022CreatedAt\u0022 = ? AND (\u0022orders\u0022.\u0022TenantId\u0022 \u003E ? OR (\u0022orders\u0022.\u0022TenantId\u0022 = ? AND \u0022orders\u0022.\u0022Id\u0022 \u003E ?)))) ORDER BY \u0022orders\u0022.\u0022CreatedAt\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022TenantId\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","offset":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? ORDER BY \u0022orders\u0022.\u0022CreatedAt\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022TenantId\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ? OFFSET ?","exists":"SELECT \u0022customers\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022customers\u0022 WHERE EXISTS(SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND \u0022orders\u0022.\u0022Id\u0022 \u003E= ?) ORDER BY \u0022customers\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","in-subquery":"SELECT \u0022customers\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022customers\u0022 WHERE \u0022customers\u0022.\u0022Id\u0022 IN (SELECT \u0022orders\u0022.\u0022CustomerId\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND \u0022orders\u0022.\u0022Id\u0022 \u003E ?) ORDER BY \u0022customers\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","cte":"WITH \u0022selected_order_ids\u0022 (\u0022Id\u0022) AS (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND \u0022orders\u0022.\u0022Id\u0022 \u003E ?) SELECT \u0022selected_order_ids\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022selected_order_ids\u0022 ORDER BY \u0022selected_order_ids\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","window":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022, (ROW_NUMBER() OVER ( PARTITION BY \u0022orders\u0022.\u0022CustomerId\u0022 ORDER BY \u0022orders\u0022.\u0022CreatedAt\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST )) AS \u0022Rank\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","union-all":"WITH \u0022selected_order_ids\u0022 (\u0022Id\u0022) AS (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND \u0022orders\u0022.\u0022Id\u0022 \u003C= ? UNION ALL SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND (\u0022orders\u0022.\u0022Id\u0022 \u003E= ? AND \u0022orders\u0022.\u0022Id\u0022 \u003C= ?)) SELECT \u0022selected_order_ids\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022selected_order_ids\u0022 ORDER BY \u0022selected_order_ids\u0022.\u0022Id\u0022 ASC NULLS LAST","union":"WITH \u0022selected_order_ids\u0022 (\u0022Id\u0022) AS (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND \u0022orders\u0022.\u0022Id\u0022 \u003C= ? UNION SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND (\u0022orders\u0022.\u0022Id\u0022 \u003E= ? AND \u0022orders\u0022.\u0022Id\u0022 \u003C= ?)) SELECT \u0022selected_order_ids\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022selected_order_ids\u0022 ORDER BY \u0022selected_order_ids\u0022.\u0022Id\u0022 ASC NULLS LAST","intersect":"WITH \u0022selected_order_ids\u0022 (\u0022Id\u0022) AS (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND \u0022orders\u0022.\u0022Id\u0022 \u003C= ? INTERSECT SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND (\u0022orders\u0022.\u0022Id\u0022 \u003E= ? AND \u0022orders\u0022.\u0022Id\u0022 \u003C= ?)) SELECT \u0022selected_order_ids\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022selected_order_ids\u0022 ORDER BY \u0022selected_order_ids\u0022.\u0022Id\u0022 ASC NULLS LAST","except":"WITH \u0022selected_order_ids\u0022 (\u0022Id\u0022) AS (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND \u0022orders\u0022.\u0022Id\u0022 \u003C= ? EXCEPT SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND (\u0022orders\u0022.\u0022Id\u0022 \u003E= ? AND \u0022orders\u0022.\u0022Id\u0022 \u003C= ?)) SELECT \u0022selected_order_ids\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022selected_order_ids\u0022 ORDER BY \u0022selected_order_ids\u0022.\u0022Id\u0022 ASC NULLS LAST","running-total":"SELECT \u0022order_lines\u0022.\u0022Id\u0022 AS \u0022Id\u0022, (SUM(\u0022order_lines\u0022.\u0022Quantity\u0022) OVER (  ORDER BY \u0022order_lines\u0022.\u0022Id\u0022 ASC NULLS LAST ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW )) AS \u0022Quantity\u0022 FROM \u0022order_lines\u0022 WHERE \u0022order_lines\u0022.\u0022TenantId\u0022 = ? ORDER BY \u0022order_lines\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","three-join":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022OrderId\u0022, \u0022customer\u0022.\u0022Name\u0022 AS \u0022Name\u0022, \u0022line\u0022.\u0022Product\u0022 AS \u0022Product\u0022, \u0022line\u0022.\u0022Quantity\u0022 AS \u0022Quantity\u0022 FROM \u0022orders\u0022 INNER JOIN \u0022customers\u0022 AS \u0022customer\u0022 ON \u0022orders\u0022.\u0022CustomerId\u0022 = \u0022customer\u0022.\u0022Id\u0022 INNER JOIN \u0022order_lines\u0022 AS \u0022line\u0022 ON \u0022orders\u0022.\u0022TenantId\u0022 = \u0022line\u0022.\u0022TenantId\u0022 AND \u0022orders\u0022.\u0022Id\u0022 = \u0022line\u0022.\u0022OrderId\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST, \u0022line\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","anti-association":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = ? AND (NOT \u0022orders\u0022.\u0022Id\u0022 IN (SELECT \u0022order_lines\u0022.\u0022OrderId\u0022 AS \u0022value\u0022 FROM \u0022order_lines\u0022 WHERE \u0022order_lines\u0022.\u0022TenantId\u0022 = ? AND \u0022order_lines\u0022.\u0022Quantity\u0022 \u003E= ?)) ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT ?","nullable-order":"S