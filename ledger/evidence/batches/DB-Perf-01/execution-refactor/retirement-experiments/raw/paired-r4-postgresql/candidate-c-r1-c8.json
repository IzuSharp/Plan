AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = $1 AND \u0022orders\u0022.\u0022Note\u0022 LIKE $2 ESCAPE E\u0027\\\\\u0027 ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT $3","customer-totals":"SELECT \u0022orders\u0022.\u0022CustomerId\u0022 AS \u0022CustomerId\u0022, COUNT(*) AS \u0022Count\u0022, SUM(\u0022orders\u0022.\u0022Total\u0022) AS \u0022Total\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = $1 GROUP BY \u0022orders\u0022.\u0022CustomerId\u0022 HAVING COUNT(*) \u003E $2 ORDER BY \u0022orders\u0022.\u0022CustomerId\u0022 ASC NULLS LAST","product-totals":"SELECT \u0022order_lines\u0022.\u0022Product\u0022 AS \u0022Product\u0022, CAST(SUM(\u0022order_lines\u0022.\u0022Quantity\u0022) AS bigint) AS \u0022Quantity\u0022 FROM \u0022order_lines\u0022 WHERE \u0022order_lines\u0022.\u0022TenantId\u0022 = $1 GROUP BY \u0022order_lines\u0022.\u0022Product\u0022 HAVING CAST(SUM(\u0022order_lines\u0022.\u0022Quantity\u0022) AS bigint) \u003E $2 ORDER BY \u0022order_lines\u0022.\u0022Product\u0022 ASC NULLS LAST","empty-sum":"SELECT SUM(\u0022orders\u0022.\u0022Total\u0022) AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = $1","cursor":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = $1 AND (\u0022orders\u0022.\u0022CreatedAt\u0022 \u003E $2 OR (\u0022orders\u0022.\u0022CreatedAt\u0022 = $3 AND (\u0022orders\u0022.\u0022TenantId\u0022 \u003E $4 OR (\u0022orders\u0022.\u0022TenantId\u0022 = $5 AND \u0022orders\u0022.\u0022Id\u0022 \u003E $6)))) ORDER BY \u0022orders\u0022.\u0022CreatedAt\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022TenantId\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT $7","offset":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = $1 ORDER BY \u0022orders\u0022.\u0022CreatedAt\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022TenantId\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT $2 OFFSET $3","exists":"SELECT \u0022customers\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022customers\u0022 WHERE EXISTS(SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = $1 AND \u0022orders\u0022.\u0022Id\u0022 \u003E= $2) ORDER BY \u0022customers\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT $3","in-subquery":"SELECT \u0022customers\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022customers\u0022 WHERE \u0022customers\u0022.\u0022Id\u0022 IN (SELECT \u0022orders\u0022.\u0022CustomerId\u0022 AS \u0022value\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = $1 AND \u0022orders\u0022.\u0022Id\u0022 \u003E $2) ORDER BY \u0022customers\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT $3","cte":"WITH \u0022selected_order_ids\u0022 (\u0022Id\u0022) AS (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = $1 AND \u0022orders\u0022.\u0022Id\u0022 \u003E $2) SELECT \u0022selected_order_ids\u0022.\u0022Id\u0022 AS \u0022value\u0022 FROM \u0022selected_order_ids\u0022 ORDER BY \u0022selected_order_ids\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT $3","window":"SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022, (ROW_NUMBER() OVER ( PARTITION BY \u0022orders\u0022.\u0022CustomerId\u0022 ORDER BY \u0022orders\u0022.\u0022CreatedAt\u0022 ASC NULLS LAST, \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST )) AS \u0022Rank\u0022 FROM \u0022orders\u0022 WHERE \u0022orders\u0022.\u0022TenantId\u0022 = $1 ORDER BY \u0022orders\u0022.\u0022Id\u0022 ASC NULLS LAST LIMIT $2","union-all":"WITH \u0022selected_order_ids\u0022 (\u0022Id\u0022) AS (SELECT \u0022orders\u0022.\u0022Id\u0022 AS \u0022Id\u0022 FROM \u002