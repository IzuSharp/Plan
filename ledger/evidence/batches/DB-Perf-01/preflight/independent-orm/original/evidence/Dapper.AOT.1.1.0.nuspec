<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Dapper.AOT</id>
    <version>1.1.0</version>
    <authors>Marc Gravell</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>Dapper.png</icon>
    <readme>readme.md</readme>
    <projectUrl>https://aot.dapperlib.dev/</projectUrl>
    <description>Build time (AOT) tools for Dapper</description>
    <copyright>Marc Gravell, 2021 onwards</copyright>
    <repository type="git" url="https://github.com/DapperLib/DapperAOT/" commit="0e071bf05e54caecfa98c885b075fa3e247f3ecc" />
    <dependencies>
      <group targetFramework="net10.0" />
      <group targetFramework=".NETFramework4.8">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="System.Collections.Immutable" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="System.Collections.Immutable" version="10.0.8" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="System.Collections.Immutable" version="10.0.8" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETCoreApp3.1">
        <dependency id="System.Collections.Immutable" version="10.0.8" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="System.Collections.Immutable" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>