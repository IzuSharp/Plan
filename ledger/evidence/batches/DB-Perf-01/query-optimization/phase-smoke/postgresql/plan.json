{
  "provider": "postgresql",
  "commands": [
    {
      "name": "baseline-postgresql-smoke",
      "phase": "correctness-smoke-not-performance",
      "argv": [
        "/tmp/DB-Perf-01-query-phases/baseline-postgresql/out/DbPerf.QueryPhases",
        "{connection}",
        "{output}/baseline.json",
        "4",
        "1",
        "initialize"
      ],
      "timeoutSeconds": 120
    },
    {
      "name": "recovered-postgresql-smoke",
      "phase": "correctness-smoke-not-performance",
      "argv": [
        "/tmp/DB-Perf-01-query-phases/recovered-postgresql/out/DbPerf.QueryPhases",
        "{connection}",
        "{output}/recovered.json",
        "4",
        "1"
      ],
      "timeoutSeconds": 120
    }
  ],
  "postgres": {
    "bin": "/tmp/DB-Perf-01-tools/postgres-tools/install/bin",
    "data": "/tmp/DB-Perf-01-query-phases/pg-data-smoke",
    "maxConnections": 16,
    "maxClientConcurrency": 1
  }
}
