  "sources": [
    {
      "metric": "primary success throughput",
      "raw": "OfferedLoad.Succeeded / EffectiveSeconds",
      "scope": "Includes accepted work drain; separate normalization to requested 1800 seconds and first-1800-second completion counters is retained."
    },
    {
      "metric": "rejection and correctness",
      "raw": "OfferedLoad.Planned/Attempted/Sent/Started/Completed/Succeeded/Failed/Rejected/Rows; OracleFailures; Cases; ApplicationConnectionsReturnedToZero",
      "scope": "Attempted=Sent+Rejected; Sent=Started=Completed; Succeeded+Failed=Completed; failures and oracles separately checked."
    },
    {
      "metric": "service and scheduled percentiles",
      "raw": "OfferedLoad.SuccessServiceHistogram/SuccessScheduledHistogram/AllCompletedScheduledHistogram/StartDelayHistogram",
      "scope": "8192 base-2 nanosecond bins, 128 subdivisions per exponent; reported microsecond bin upper bounds. Rejected work has no success latency."
    },
    {
      "metric": "whole-client steady CPU per success",
      "raw": "(ProcessAfter.UserCpuSeconds-ProcessBefore.UserCpuSeconds + ProcessAfter.SystemCpuSeconds-ProcessBefore.SystemCpuSeconds) / OfferedLoad.Succeeded",
      "scope": "Whole-process execution CPU includes workload scheduler, harness, driver, DTO and runtime/GC; blocked wall wait is not CPU. Not framework-only attribution."
    },
    {
      "metric": "whole-process allocated bytes",
      "raw": "AllocatedBytes; AllocatedBefore/AllocatedAfter",
      "scope": "C# process counter delta; Java ThreadMXBean unavailable gives null in both runs. Native allocation unavailable. No framework/driver/DTO subtraction."
    },
    {
      "metric": "consumer reported peak RSS",
      "raw": "ProcessAfter.PeakRssBytes",
      "scope": "High-water value visible to this snapshot after business measurement; may include earlier warmup, not post-exit lifetime."
    },
    {
      "metric": "OS lifecycle CPU and maxRSS",
      "raw": "<cell>.command.json.processLifetimeUserCpuSeconds/processLifetimeSystemCpuSeconds/processLifetimeMaxRssBytes",
      "scope": "OS wait4 lifecycle values include startup, warmup, release, idle and exit. Do not add to primary client CPU."
    },
    {
      "metric": "observer client RSS/PSS peaks",
      "raw": "<cell>.resources.jsonl client record; monotonicNs/acquiredThroughMonotonicNs; matching client PID/startTicks",
      "scope": "Maximum discrete sample fully inside result SteadyStartMonotonicNs..SteadyEndMonotonicNs. Do not merge with other peak sources or impose ordering."
    },
    {
      "metric": "released idle RSS",
      "raw": "Idle.After.RssBytes and Idle.ObservedSeconds",
      "scope": "Actual observed duration, no forced GC; cannot prove leak/no leak. 02 actual 14.997119729 seconds is kept."
    },
    {
      "metric": "dotnet GC counts and time",
      "raw": "Gen0/Gen1/Gen2; EF-only GcPauseTicks",
      "scope": "Separate process generation counts, not summed; EF ticks are TimeSpan 100 ns. Stock and Satori API accounting are not assumed equivalent; Dapper pause missing=null."
    },
    {
      "metric": "Java GC counts and collection time",
      "raw": "GcAfter minus GcBefore; per-collector Count/CollectionMilliseconds",
      "scope": "Process MXBean counters, not a measured pause histogram. Unsupported counters remain null."
    },
    {
      "metric": "Java heap API values",
      "raw": "ProcessAfter.JavaHeapUsedBytes=(Runtime.totalMemory-freeMemory); JavaHeapCommittedBytes=Runtime.totalMemory; JavaHeapMaximumBytes=Runtime.maxMemory",
      "scope": "Historical committed field name retained; Runtime API values are not physical RSS or proof of OS committed pages."
    },
    {
      "metric": "PostgreSQL server costs",
      "raw": "resources server records; postgres-owner.json wait4; postgres-stats-before/after.json",
      "scope": "All four observed only postmaster, so whole-server steady CPU/RSS/PSS are null. Observed subset endpoint own+reaped deltas and lifecycle wait4 are separate; wider pg_stat_database window is not pure steady execution cost."
    },
    {
      "metric": "per-case population",
      "raw": "Cases[].Name/Started/Succeeded/Failed/Rows; global job index modulo 35",
      "scope": "Planned count derived from immutable schedule; rejected=planned-started only after full-drain accounting. Planned vs successful shares retained; no CPU attribution from aggregate alone."
    },
    {
      "metric": "original strict state and precise exception",
      "raw": "cell-status.json and analysis/02-idle-deviation-review.json",
      "scope": "Only exact-name/result/status/review SHA-bound 02 classification accepts business window; strict failed and strict idle false persist."
    }
  ],
