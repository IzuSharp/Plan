{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IzuSharp/Plan/schemas/independent-graph-v1.schema.json",
  "title": "Independent implementation direction graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "direction", "task_prefix", "implementation_authorized",
    "design", "nodes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "direction": {"$ref": "#/$defs/nonempty"},
    "task_prefix": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-$"},
    "implementation_authorized": {"type": "boolean"},
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "contracts"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "contracts": {"$ref": "#/$defs/nonemptyReferences"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"implementation_authorized": {"const": false}}},
      "then": {
        "properties": {
          "nodes": {"items": {"properties": {"status": {"const": "planned_candidate"}}}}
        }
      }
    }
  ],
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
    "nonemptyReferences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "status", "track", "owner_role", "start_dependencies",
        "acceptance_dependencies", "contracts", "packet", "write_scopes", "validation"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
        "title": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["planned_candidate", "in_progress", "completed", "accepted"]},
        "track": {"enum": ["primary", "follow_on", "optional", "migration"]},
        "owner_role": {"$ref": "#/$defs/nonempty"},
        "start_dependencies": {"$ref": "#/$defs/references"},
        "acceptance_dependencies": {"$ref": "#/$defs/references"},
        "contracts": {"$ref": "#/$defs/nonemptyReferences"},
        "packet": {"$ref": "#/$defs/nonempty"},
        "write_scopes": {"$ref": "#/$defs/references"},
        "validation": {"$ref": "#/$defs/nonemptyReferences"}
      }
    }
  }
}
