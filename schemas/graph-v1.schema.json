{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IzuSharp/Plan/schemas/graph-v1.schema.json",
  "title": "NativeWeave independent research/documentation/delivery graph v1",
  "type": "object",
  "required": [
    "schema_version",
    "graph_kind",
    "created_at",
    "authority",
    "graph_status",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "graph_kind": {
      "enum": [
        "research",
        "documentation",
        "delivery"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "authority": {
      "const": "IzuSharp/Plan"
    },
    "graph_status": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "title",
        "phase",
        "status",
        "revision",
        "author",
        "owner_role",
        "start_dependencies",
        "acceptance_dependencies",
        "dependency_pins",
        "conditional_dependencies",
        "selection_inputs",
        "contract_inputs",
        "research_refs",
        "documentation_refs",
        "outputs",
        "write_scopes",
        "resource_locks",
        "prompt",
        "packet_sha256",
        "acceptance_evidence",
        "independent_reviewers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(R|D|A|B)\\d{2,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "A",
            "B",
            "A+B",
            "future"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "draft_ready",
            "planned_candidate",
            "in_progress",
            "drafting",
            "partially_evidenced",
            "partially_verified",
            "review_ready",
            "accepted",
            "delivered",
            "complete",
            "completed",
            "done",
            "verified",
            "failed",
            "blocked"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[\\w.]+)?$"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "start_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(R|D|A|B)\\d{2,}$"
          },
          "uniqueItems": true
        },
        "acceptance_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(R|D|A|B)\\d{2,}$"
          },
          "uniqueItems": true
        },
        "research_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(R|D|A|B)\\d{2,}$"
          },
          "uniqueItems": true
        },
        "documentation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(R|D|A|B)\\d{2,}$"
          },
          "uniqueItems": true
        },
        "selection_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(R|D|A|B)\\d{2,}$"
          },
          "uniqueItems": true
        },
        "dependency_pins": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "conditional_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "condition",
              "task_id",
              "revision",
              "gate",
              "reason"
            ],
            "properties": {
              "condition": {
                "type": "object",
                "required": [
                  "task_id",
                  "selection_status"
                ],
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "selection_status": {
                    "const": "selected"
                  }
                }
              },
              "task_id": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              },
              "gate": {
                "const": "acceptance"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "contract_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version",
              "required_status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^C-[A-Z]+-\\d+$"
              },
              "version": {
                "type": "string"
              },
              "required_status": {
                "const": "accepted"
              }
            },
            "additionalProperties": false
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "write_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "resource_locks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "prompt": {
          "type": "string"
        },
        "packet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "acceptance_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "manifest_path",
              "sha256"
            ],
            "properties": {
              "manifest_path": {
                "type": "string",
                "pattern": "^(Plan|NativeWeave-Design|NativeWeave):"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "independent_reviewers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "manifest_path",
              "sha256"
            ],
            "properties": {
              "manifest_path": {
                "type": "string",
                "pattern": "^(Plan|NativeWeave-Design|NativeWeave):"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "verification_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "os",
              "arch",
              "kind"
            ],
            "properties": {
              "os": {
                "enum": [
                  "Windows",
                  "Linux"
                ]
              },
              "arch": {
                "enum": [
                  "x64",
                  "arm64",
                  "x86"
                ]
              },
              "target_rid": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "native_aot_run",
                  "model_check",
                  "build_run",
                  "conformance_run"
                ]
              }
            }
          }
        },
        "selection_status": {
          "enum": [
            "undecided",
            "selected",
            "excluded",
            "not_applicable"
          ]
        },
        "implementation_authorization": {
          "type": "object",
          "required": [
            "status",
            "approval_record"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_authorized",
                "authorized"
              ]
            },
            "approval_record": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "manifest_path",
                    "sha256"
                  ],
                  "properties": {
                    "manifest_path": {
                      "type": "string",
                      "pattern": "^(Plan|NativeWeave-Design|NativeWeave):"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      },
      "additionalProperties": true
    },
    "evidenceReference": {
      "type": "object",
      "required": [
        "manifest_path",
        "sha256"
      ],
      "properties": {
        "manifest_path": {
          "type": "string",
          "pattern": "^(Plan|NativeWeave-Design|NativeWeave):"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "contractInput": {
      "type": "object",
      "required": [
        "id",
        "version",
        "required_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C-[A-Z]+-\\d+$"
        },
        "version": {
          "type": "string"
        },
        "required_status": {
          "const": "accepted"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "graph_kind": {
            "const": "delivery"
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "required": [
                "verification_requirements",
                "selection_required",
                "selection_status",
                "implementation_authorization"
              ]
            }
          }
        }
      }
    }
  ]
}
